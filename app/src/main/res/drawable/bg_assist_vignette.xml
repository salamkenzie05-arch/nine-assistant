<?xml version="1.0" encoding="utf-8"?>
<!-- Layar asisten: peredam rata satu warna (tanpa gradasi, supaya aplikasi di belakang tidak ramai)
     ditambah vinyet emas Nine yang lembut di tepi layar. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/assist_dim" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.5"
                android:centerY="0.55"
                android:endColor="@color/nine_vignette_edge"
                android:gradientRadius="105%"
                android:startColor="@color/nine_vignette_clear"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
