<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Nine" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/nine_accent</item>
        <item name="colorOnPrimary">@color/nine_bg</item>
        <item name="colorSecondary">@color/nine_gold</item>
        <!-- Semua kontrol (radio, saklar, tombol teks/outline, kolom isian, pemilih tanggal) berwarna emas Nine, bukan biru Material. -->
        <item name="colorPrimaryContainer">@color/nine_pill</item>
        <item name="colorOnPrimaryContainer">@color/nine_on_bg</item>
        <item name="colorTertiary">@color/nine_gold</item>
        <item name="colorTertiaryContainer">@color/nine_pill</item>
        <item name="colorOnTertiaryContainer">@color/nine_on_bg</item>
        <item name="colorControlActivated">@color/nine_accent</item>
        <item name="colorAccent">@color/nine_accent</item>
        <item name="android:colorAccent">@color/nine_accent</item>
        <item name="android:textColorHighlight">@color/nine_vignette_edge</item>
        <item name="colorSurface">@color/nine_card</item>
        <item name="colorOnSurface">@color/nine_on_bg</item>
        <!-- Matikan nuansa lavender bawaan Material 3 (sheet, toggle, outline, tint elevasi). -->
        <item name="colorSurfaceContainerLowest">@color/nine_card</item>
        <item name="colorSurfaceContainerLow">@color/nine_card</item>
        <item name="colorSurfaceContainer">@color/nine_card</item>
        <item name="colorSurfaceContainerHigh">@color/nine_pill</item>
        <item name="colorSurfaceContainerHighest">@color/nine_pill</item>
        <item name="colorSurfaceVariant">@color/nine_pill</item>
        <item name="colorOnSurfaceVariant">@color/nine_muted</item>
        <item name="colorSecondaryContainer">@color/nine_pill</item>
        <item name="colorOnSecondaryContainer">@color/nine_on_bg</item>
        <item name="colorOutline">@color/nine_outline</item>
        <item name="colorOutlineVariant">@color/nine_outline_variant</item>
        <item name="bottomSheetDialogTheme">@style/Nine.BottomSheetDialog</item>
        <item name="android:colorBackground">@color/nine_bg</item>
        <item name="android:windowBackground">@color/nine_bg</item>
        <item name="android:textColorPrimary">@color/nine_on_bg</item>
        <item name="android:textColorSecondary">@color/nine_muted</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Layar asisten (tombol power / "hey nine" saat Nine jadi asisten default): transparan, aplikasi di belakang tetap terlihat. -->
    <style name="Theme.Nine.Assist" parent="Theme.Nine">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Translucent</item>
    </style>

    <style name="Nine.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Nine.BottomSheet</item>
    </style>

    <style name="Nine.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/nine_card</item>
    </style>

    <style name="Nine.SectionTitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:textColor">@color/nine_gold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Baris kustomisasi yang belum aktif: redup, dengan keterangan di kanan. -->

    <style name="Nine.MenuRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:drawablePadding">16dp</item>
        <item name="android:drawableTint">@color/nine_gold</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:textColor">@color/nine_on_bg</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Kartu isi (Pengaturan, Nine, Keuangan): latar bulat, isi vertikal. -->
    <style name="Nine.Card" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
    </style>


    <style name="Nine.Divider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:background">@color/nine_pill</item>
    </style>

    <style name="Nine.Status" parent="Nine.Body">
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Nine.Body" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/nine_muted</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>
</resources>
