<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp">

    <EditText
        android:id="@+id/inputSpaceName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/spaces_name_hint"
        android:importantForAutofill="no"
        android:inputType="textCapSentences"
        android:maxLength="28"
        android:maxLines="1"
        android:minHeight="48dp"
        android:textColor="@color/nine_on_bg"
        android:textColorHint="@color/nine_muted" />

    <EditText
        android:id="@+id/inputSpaceNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/spaces_note_hint"
        android:importantForAutofill="no"
        android:inputType="textCapSentences|textMultiLine"
        android:maxLength="300"
        android:maxLines="4"
        android:minHeight="48dp"
        android:textColor="@color/nine_on_bg"
        android:textColorHint="@color/nine_muted" />
</LinearLayout>
