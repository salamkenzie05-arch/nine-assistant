<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nine_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back"
            app:tint="@color/nine_on_bg" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/settings"
            android:textColor="@color/nine_on_bg"
            android:textSize="20sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="48dp">

            <!-- Mode internet -->
            <TextView style="@style/Nine.SectionTitle" android:text="@string/sec_internet" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchInternet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/internet_switch"
                android:textColor="@color/nine_on_bg" />

            <TextView style="@style/Nine.Body" android:text="@string/internet_help" />

            <EditText
                android:id="@+id/editGeminiKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/gemini_key_hint"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:minHeight="48dp"
                android:textColor="@color/nine_on_bg"
                android:textColorHint="@color/nine_muted"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGetKey"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gemini_get_key" />

            <EditText
                android:id="@+id/editGeminiModel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="gemini-flash-latest"
                android:importantForAutofill="no"
                android:inputType="text"
                android:minHeight="48dp"
                android:textColor="@color/nine_on_bg"
                android:textColorHint="@color/nine_muted"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/editCity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/city_hint"
                android:importantForAutofill="no"
                android:inputType="textCapWords"
                android:minHeight="48dp"
                android:textColor="@color/nine_on_bg"
                android:textColorHint="@color/nine_muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtInternetStatus"
                style="@style/Nine.Body"
                android:textSize="12sp" />

            <!-- Otak AI -->
            <TextView style="@style/Nine.SectionTitle" android:text="@string/sec_brain" />

            <TextView
                android:id="@+id/brainStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/nine_on_bg"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/brainDetail"
                style="@style/Nine.Body"
                android:layout_marginTop="4dp" />

            <RadioGroup
                android:id="@+id/groupVariant"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <RadioButton android:id="@+id/variantE2b" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/variant_e2b" android:textColor="@color/nine_on_bg" />
                <RadioButton android:id="@+id/variantE4b" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/variant_e4b" android:textColor="@color/nine_on_bg" />
            </RadioGroup>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/brainProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                app:trackCornerRadius="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDownload"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/model_download" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnImport"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/model_import" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDelete"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/model_delete" />

            <EditText
                android:id="@+id/editToken"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/hf_token_hint"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:minHeight="48dp"
                android:textColor="@color/nine_on_bg"
                android:textColorHint="@color/nine_muted"
                android:textSize="14sp" />

            <TextView style="@style/Nine.Body" android:text="@string/hf_token_help" android:textSize="12sp" />

            <!-- Wake word -->
            <TextView style="@style/Nine.SectionTitle" android:text="@string/sec_wake" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchWake"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/wake_switch"
                android:textColor="@color/nine_on_bg" />

            <EditText
                android:id="@+id/editWakePhrase"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="hey nine"
                android:importantForAutofill="no"
                android:inputType="text"
                android:minHeight="48dp"
                android:textColor="@color/nine_on_bg"
                android:textColorHint="@color/nine_muted" />

            <TextView style="@style/Nine.Body" android:text="@string/wake_help" android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOverlay"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/wake_overlay_button" />

            <TextView
                android:id="@+id/txtWakeStatus"
                style="@style/Nine.Body"
                android:textSize="12sp" />

            <!-- Tampilan -->
            <TextView style="@style/Nine.SectionTitle" android:text="@string/sec_look" />

            <RadioGroup
                android:id="@+id/groupTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton android:id="@+id/themeSystem" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/theme_system" android:textColor="@color/nine_on_bg" />
                <RadioButton android:id="@+id/themeLight" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/theme_light" android:textColor="@color/nine_on_bg" />
                <RadioButton android:id="@+id/themeDark" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/theme_dark" android:textColor="@color/nine_on_bg" />
            </RadioGroup>

            <!-- Bahasa & panggilan -->
            <TextView style="@style/Nine.SectionTitle" android:text="@string/sec_language" />

            <RadioGroup
                android:id="@+id/groupLang"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton android:id="@+id/langId" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="Bahasa Indonesia" android:textColor="@color/nine_on_bg" />
                <RadioButton android:id="@+id/langEn" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="English" android:textColor="@color/nine_on_bg" />
            </RadioGroup>

            <TextView style="@style/Nine.Body" android:layout_marginTop="8dp" android:text="@string/honorific_label" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/editHonId"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Tuan"
                    android:importantForAutofill="no"
                    android:inputType="textPersonName|textCapWords"
                    android:minHeight="48dp"
                    android:textColor="@color/nine_on_bg"
                    android:textColorHint="@color/nine_muted" />

                <EditText
                    android:id="@+id/editHonEn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:hint="sir"
                    android:importantForAutofill="no"
                    android:inputType="textPersonName"
                    android:minHeight="48dp"
                    android:textColor="@color/nine_on_bg"
                    android:textColorHint="@color/nine_muted" />
            </LinearLayout>

            <!-- Suara -->
            <TextView style="@style/Nine.SectionTitle" android:text="@string/sec_voice" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchSpeak"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/speak_replies"
                android:textColor="@color/nine_on_bg" />

            <TextView style="@style/Nine.Body" android:layout_marginTop="8dp" android:text="@string/voice_label" />

            <Spinner
                android:id="@+id/spinnerVoice"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPreview"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/voice_preview" />

            <TextView style="@style/Nine.Body" android:text="@string/voice_help" android:textSize="12sp" />

            <!-- Asisten default -->
            <TextView style="@style/Nine.SectionTitle" android:text="@string/sec_assistant" />

            <TextView style="@style/Nine.Body" android:text="@string/assistant_help" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDefaultAssistant"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/assistant_button" />

            <!-- Privasi -->
            <TextView style="@style/Nine.SectionTitle" android:text="@string/sec_privacy" />

            <TextView style="@style/Nine.Body" android:text="@string/privacy_text" />

            <TextView
                android:id="@+id/txtVersion"
                style="@style/Nine.Body"
                android:layout_marginTop="16dp"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
