<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nine_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back"
            app:tint="@color/nine_gold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/settings"
            android:textColor="@color/nine_on_bg"
            android:textSize="22sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView style="@style/Nine.SectionTitle" android:text="@string/sec_brain_group" />

            <LinearLayout style="@style/Nine.Card">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchInternet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/internet_switch"
                    android:textColor="@color/nine_on_bg"
                    android:textSize="15sp" />

                <LinearLayout
                    android:id="@+id/geminiFields"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:hint="@string/gemini_key_hint"
                        app:endIconMode="password_toggle">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editGeminiKey"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAutofill="no"
                            android:inputType="textPassword"
                            android:maxLines="1"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGetKey"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/nine_gold"
                        android:text="@string/gemini_get_key" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:hint="@string/gemini_model_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editGeminiModel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAutofill="no"
                            android:inputType="text"
                            android:maxLines="1"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/city_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editCity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAutofill="no"
                        android:inputType="textCapWords"
                        android:maxLines="1"
                        android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/txtInternetStatus"
                    style="@style/Nine.Status"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <Space android:layout_width="match_parent" android:layout_height="12dp" />

            <LinearLayout style="@style/Nine.Card">

                <TextView
                    android:id="@+id/brainStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/nine_on_bg"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/brainDetail"
                    style="@style/Nine.Status"
                    android:visibility="gone" />

                <RadioGroup
                    android:id="@+id/groupVariant"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <RadioButton
                        android:id="@+id/variantE2b"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="44dp"
                        android:text="@string/variant_e2b"
                        android:textColor="@color/nine_on_bg"
                        android:textSize="15sp" />
                    <RadioButton
                        android:id="@+id/variantE4b"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="44dp"
                        android:text="@string/variant_e4b"
                        android:textColor="@color/nine_on_bg"
                        android:textSize="15sp" />
                </RadioGroup>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/brainProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:visibility="gone"
                    app:trackCornerRadius="4dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDownload"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/model_download" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnImport"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:text="@string/model_import_short" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDelete"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_weight="1"
                        android:text="@string/model_delete" />
                </LinearLayout>

                <View style="@style/Nine.Divider" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchGpu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/gpu_switch"
                    android:textColor="@color/nine_on_bg"
                    android:textSize="15sp" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:hint="@string/hf_token_hint"
                    app:endIconMode="password_toggle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editToken"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAutofill="no"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <TextView style="@style/Nine.SectionTitle" android:text="@string/sec_voice_group" />

            <LinearLayout style="@style/Nine.Card">

                <RadioGroup
                    android:id="@+id/groupLang"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <RadioButton
                        android:id="@+id/langId"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:minHeight="44dp"
                        android:text="Indonesia"
                        android:textColor="@color/nine_on_bg"
                        android:textSize="15sp" />
                    <RadioButton
                        android:id="@+id/langEn"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:minHeight="44dp"
                        android:text="English"
                        android:textColor="@color/nine_on_bg"
                        android:textSize="15sp" />
                </RadioGroup>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnProfile"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/profile_button" />

                <View style="@style/Nine.Divider" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchSpeak"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/speak_replies"
                    android:textColor="@color/nine_on_bg"
                    android:textSize="15sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPreview"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/voice_preview" />
            </LinearLayout>

            <TextView style="@style/Nine.SectionTitle" android:text="@string/sec_memory_group" />

            <LinearLayout style="@style/Nine.Card">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchMemory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/memory_auto"
                    android:textColor="@color/nine_on_bg"
                    android:textSize="15sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchAutoSupport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/support_auto"
                    android:textColor="@color/nine_on_bg"
                    android:textSize="15sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchInbodyOcr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/inbody_ocr"
                    android:textColor="@color/nine_on_bg"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/txtMemoryCount"
                    style="@style/Nine.Status" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMemoryManage"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/memory_manage" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMemoryClear"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/memory_clear" />
                </LinearLayout>
            </LinearLayout>

            <TextView style="@style/Nine.SectionTitle" android:text="@string/sec_wake_group" />

            <LinearLayout style="@style/Nine.Card">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchWake"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/wake_switch"
                    android:textColor="@color/nine_on_bg"
                    android:textSize="15sp" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:hint="@string/wake_phrase_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editWakePhrase"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/txtWakeStatus"
                    style="@style/Nine.Status"
                    android:layout_marginTop="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOverlay"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/wake_overlay_button" />

                <View style="@style/Nine.Divider" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDefaultAssistant"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:text="@string/assistant_button" />
            </LinearLayout>

            <TextView style="@style/Nine.SectionTitle" android:text="@string/sec_loc_cal" />

            <LinearLayout style="@style/Nine.Card">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/location_switch"
                    android:textColor="@color/nine_on_bg"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/txtLocationStatus"
                    style="@style/Nine.Status"
                    android:textColor="@color/nine_gold" />

                <View style="@style/Nine.Divider" />

                <TextView
                    style="@style/Nine.Status"
                    android:layout_marginTop="0dp"
                    android:text="@string/calendar_target" />

                <Spinner
                    android:id="@+id/spinnerCalendar"
                    android:layout_width="match_parent"
                    android:layout_height="48dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCalendarAccess"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/calendar_access" />
            </LinearLayout>

            <TextView style="@style/Nine.SectionTitle" android:text="@string/sec_alarm" />

            <LinearLayout style="@style/Nine.Card">

                <RadioGroup
                    android:id="@+id/groupAlarmEngine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <RadioButton
                        android:id="@+id/alarmEngineNine"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:minHeight="44dp"
                        android:text="@string/alarm_engine_nine"
                        android:textColor="@color/nine_on_bg"
                        android:textSize="15sp" />
                    <RadioButton
                        android:id="@+id/alarmEngineClock"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:minHeight="44dp"
                        android:text="@string/alarm_engine_clock"
                        android:textColor="@color/nine_on_bg"
                        android:textSize="15sp" />
                </RadioGroup>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnManageAlarms"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/alarm_manage" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFullScreen"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:text="@string/alarm_fullscreen"
                    android:textColor="@color/nine_gold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/a11ySection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView style="@style/Nine.SectionTitle" android:text="@string/sec_a11y" />

                <LinearLayout style="@style/Nine.Card">

                    <TextView
                        android:id="@+id/txtA11yStatus"
                        style="@style/Nine.Status"
                        android:layout_marginTop="0dp"
                        android:textColor="@color/nine_on_bg"
                        android:textSize="14sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnA11y"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/a11y_button" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAppInfo"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/a11y_appinfo_button" />

                    <TextView
                        android:id="@+id/txtA11yHelp"
                        style="@style/Nine.Status"
                        android:layout_marginTop="8dp"
                        android:text="@string/a11y_help" />
                </LinearLayout>
            </LinearLayout>

            <TextView style="@style/Nine.SectionTitle" android:text="@string/sec_look" />

            <LinearLayout style="@style/Nine.Card">

                <RadioGroup
                    android:id="@+id/groupTheme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <RadioButton
                        android:id="@+id/themeSystem"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:minHeight="44dp"
                        android:text="@string/theme_system"
                        android:textColor="@color/nine_on_bg"
                        android:textSize="15sp" />
                    <RadioButton
                        android:id="@+id/themeLight"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:minHeight="44dp"
                        android:text="@string/theme_light"
                        android:textColor="@color/nine_on_bg"
                        android:textSize="15sp" />
                    <RadioButton
                        android:id="@+id/themeDark"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:minHeight="44dp"
                        android:text="@string/theme_dark"
                        android:textColor="@color/nine_on_bg"
                        android:textSize="15sp" />
                </RadioGroup>

                <View style="@style/Nine.Divider" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchMusic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/music_switch"
                    android:textColor="@color/nine_on_bg"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView style="@style/Nine.SectionTitle" android:text="@string/sec_privacy" />

            <LinearLayout style="@style/Nine.Card">

                <TextView
                    style="@style/Nine.Body"
                    android:textSize="13sp"
                    android:text="@string/privacy_text" />

                <TextView
                    android:id="@+id/txtVersion"
                    style="@style/Nine.Status"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
