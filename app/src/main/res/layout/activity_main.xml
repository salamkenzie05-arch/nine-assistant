<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nine_bg">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Bilah atas: hanya NINE di tengah (ketuk untuk menu) -->
        <FrameLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="4dp">

            <!-- Dua sisi sama lebar (bobot 1) supaya NINE tepat di tengah layar; lencana BETA menggantung di kanannya.
                 Jarak antarhuruf memakai spasi sepertiga-em (U+2004) milik fontnya, bukan letterSpacing: letterSpacing
                 menambah ruang sisa yang cara hitungnya beda antarversi Android, sehingga NINE bisa geser dari tengah. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/txtTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_menu"
                    android:fontFamily="@font/nine_light"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="N&#x2004;I&#x2004;N&#x2004;E"
                    android:textColor="@color/nine_on_bg"
                    android:textSize="22sp" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/txtBeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start|center_vertical"
                        android:background="@drawable/bg_beta_badge"
                        android:letterSpacing="0.12"
                        android:paddingStart="6dp"
                        android:paddingTop="1dp"
                        android:paddingEnd="6dp"
                        android:paddingBottom="1dp"
                        android:text="BETA"
                        android:textColor="@color/nine_gold"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- Ruang obrolan aktif (ketuk untuk kembali ke obrolan utama) -->
        <TextView
            android:id="@+id/txtSpace"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_user_pill"
            android:contentDescription="@string/spaces_back_cd"
            android:ellipsize="end"
            android:maxLines="1"
            android:maxWidth="260dp"
            android:paddingStart="14dp"
            android:paddingTop="5dp"
            android:paddingEnd="14dp"
            android:paddingBottom="5dp"
            android:textColor="@color/nine_gold"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Kartu aktivasi otak AI -->
        <LinearLayout
            android:id="@+id/modelCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/modelTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/model_card_title"
                android:textColor="@color/nine_on_bg"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/modelText"
                style="@style/Nine.Body"
                android:layout_marginTop="4dp"
                android:text="@string/model_card_text" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/modelProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:trackCornerRadius="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="end"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnModelSecondary"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/model_later" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnModelPrimary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/model_download" />
            </LinearLayout>
        </LinearLayout>

        <!-- Riwayat, dengan gradasi tepi yang memakai warna latar (bukan efek fading bawaan) -->
        <id.nine.assistant.ui.MaxHeightFrameLayout
            android:id="@+id/listFrame"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingTop="24dp"
                android:paddingBottom="20dp" />

            <View
                android:id="@+id/fadeTop"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:layout_gravity="top"
                android:background="@drawable/fade_top" />

            <View
                android:id="@+id/fadeBottom"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:layout_gravity="bottom"
                android:background="@drawable/fade_bottom" />
        </id.nine.assistant.ui.MaxHeightFrameLayout>

        <!-- Transkrip langsung -->
        <TextView
            android:id="@+id/txtPartial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="3"
            android:minHeight="28dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:textColor="@color/nine_muted"
            android:textSize="17sp" />

        <!-- Banner perekam suara -->
        <TextView
            android:id="@+id/txtRecording"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_user_pill"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp"
            android:textColor="#E5484D"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Kolom ketik (disembunyikan sampai tombol keyboard ditekan) -->
        <LinearLayout
            android:id="@+id/inputRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_user_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="4dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btnAttach"
                android:layout_width="44dp"
                android:layout_height="48dp"
                android:layout_marginStart="-12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_attach"
                android:src="@drawable/ic_add"
                app:tint="@color/nine_gold" />

            <EditText
                android:id="@+id/inputText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="@string/hint_input"
                android:imeOptions="actionSend"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:maxLines="3"
                android:minHeight="48dp"
                android:textColor="@color/nine_on_bg"
                android:textColorHint="@color/nine_muted" />

            <ImageButton
                android:id="@+id/btnSend"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_send"
                android:src="@drawable/ic_send"
                app:tint="@color/nine_gold" />
        </LinearLayout>

        <!-- Tuner gitar (muncul saat diminta) -->
        <id.nine.assistant.ui.TunerView
            android:id="@+id/tunerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="6dp"
            android:visibility="gone" />

        <!-- Orb + tombol samping -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="200dp">

            <id.nine.assistant.ui.NineFaceView
                android:id="@+id/orb"
                android:layout_width="190dp"
                android:layout_height="190dp"
                android:layout_gravity="center"
                android:clickable="true"
                android:contentDescription="@string/cd_mic"
                android:focusable="true" />

            <ImageButton
                android:id="@+id/btnKeyboard"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="24dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_keyboard"
                android:src="@drawable/ic_keyboard"
                app:tint="@color/nine_gold" />

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="24dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/hub_cd"
                android:src="@drawable/ic_menu"
                app:tint="@color/nine_gold" />

        </FrameLayout>

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="16dp"
            android:text="@string/status_idle"
            android:textColor="@color/nine_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <id.nine.assistant.ui.EdgeGlowView
        android:id="@+id/edgeGlow"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Muncratan hati (usap orb 5 detik) -->
    <id.nine.assistant.ui.HeartBurstView
        android:id="@+id/hearts"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
