<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <TextView
        android:id="@+id/hubFinance"
        style="@style/Nine.MenuRow"
        android:drawableStart="@drawable/ic_wallet"
        android:text="@string/hub_finance" />

    <TextView
        android:id="@+id/hubTodo"
        style="@style/Nine.MenuRow"
        android:drawableStart="@drawable/ic_checklist"
        android:text="@string/todo_title" />

    <TextView
        android:id="@+id/hubSpaces"
        style="@style/Nine.MenuRow"
        android:drawableStart="@drawable/ic_chat"
        android:text="@string/hub_spaces" />

    <TextView
        android:id="@+id/hubNine"
        style="@style/Nine.MenuRow"
        android:drawableStart="@drawable/ic_nine"
        android:text="@string/hub_nine" />
</LinearLayout>
