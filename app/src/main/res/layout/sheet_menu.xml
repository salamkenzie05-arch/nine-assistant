<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/nine_light"
        android:gravity="center"
        android:letterSpacing="0.35"
        android:text="NINE"
        android:textColor="@color/nine_on_bg"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/menuBrain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:textColor="@color/nine_orange"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/menuAlarms"
        style="@style/Nine.MenuRow"
        android:drawableStart="@drawable/ic_alarm"
        android:text="@string/alarms_title" />

    <TextView
        android:id="@+id/menuTodo"
        style="@style/Nine.MenuRow"
        android:drawableStart="@drawable/ic_checklist"
        android:text="@string/todo_title" />

    <TextView
        android:id="@+id/menuSettings"
        style="@style/Nine.MenuRow"
        android:drawableStart="@drawable/ic_settings"
        android:text="@string/settings" />

    <TextView
        style="@style/Nine.SectionTitle"
        android:layout_marginTop="16dp"
        android:text="@string/menu_lang" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/menuLang"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/menuLangId"
            style="@style/Nine.Toggle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Indonesia" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/menuLangEn"
            style="@style/Nine.Toggle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="English" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <TextView
        style="@style/Nine.SectionTitle"
        android:layout_marginTop="16dp"
        android:text="@string/menu_theme" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/menuTheme"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/menuThemeSystem"
            style="@style/Nine.Toggle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/theme_system" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/menuThemeLight"
            style="@style/Nine.Toggle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/theme_light" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/menuThemeDark"
            style="@style/Nine.Toggle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/theme_dark" />
    </com.google.android.material.button.MaterialButtonToggleGroup>
</LinearLayout>
